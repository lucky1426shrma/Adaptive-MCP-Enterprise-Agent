# =============================================================
# Adaptive MCP Enterprise Agent — Environment Configuration
# =============================================================
# Copy this file to `.env` (in backend/, or project root depending
# on how you run things locally) and fill in real values.
# Never commit a real `.env` file. Never hard-code secrets in code.

# --- Phase 1: Application (ACTIVE) -----------------------------
APP_NAME=adaptive-mcp-enterprise-agent
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | console
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------
# Everything below is NOT read by the application yet, EXCEPT the
# RAG MCP / DB MCP blocks (Phase 4/5), which the backend now reads.
# -----------------------------------------------------------------

# --- Phase 7: LLM provider — OpenRouter is the ONLY LLM provider (ACTIVE) ---
# SECURITY: a real key was previously committed here in plaintext and has
# been removed — treat it as compromised and revoke it at
# https://openrouter.ai/settings/keys if it's yours.
OPENROUTER_API_KEY=sk-or-v1-REPLACE-WITH-YOUR-OWN-KEY
# `openai/gpt-4o` (the previous value here) is a PAID model — this
# project's model_validation.py checks live OpenRouter pricing at
# startup and raises if the configured model isn't $0, which crashes
# the whole backend on boot. `openai/gpt-oss-120b:free` is confirmed
# genuinely free.
OPENROUTER_MODEL=openai/gpt-oss-120b:free   # must be an explicitly $0 OpenRouter model ID at time of use, e.g. one ending in ':free'
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60.0

LLM_MAX_TOOL_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=90.0

# --- Phase 8: Agentic RAG (ACTIVE) ---
RAG_MAX_RETRIEVAL_ATTEMPTS=3

# --- Phase 9: Security (ACTIVE) ---
# Optional shared application-level key for the backend's own public
# endpoints (distinct from every RAG_MCP_AUTH_TOKEN / DB_MCP_AUTH_TOKEN
# / GITHUB_MCP_AUTH_TOKEN above, which protect a different boundary).
# Leave unset for open local access.
# BACKEND_API_KEY=

RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60.0

# Only set true behind a reverse proxy that itself sets/overwrites
# X-Forwarded-For — never on the open internet.
TRUST_PROXY_HEADERS=false

# --- Phase 4: RAG MCP (ACTIVE — read by backend/app/config.py) ---
# Trailing slash matters: see services/rag-mcp/app/server.py's mounting
# note — hitting the bare "/mcp" path triggers a redirect that isn't
# reliably replayed for POST bodies by every client/proxy combination.
RAG_MCP_URL=http://localhost:8001/mcp/
RAG_MCP_AUTH_TOKEN=dev-local-only-change-me

# --- Phase 5: Database MCP (ACTIVE — read by backend/app/config.py) ---
DB_MCP_URL=http://localhost:8002/mcp/
DB_MCP_AUTH_TOKEN=dev-local-only-change-me

# How long the backend waits on any single MCP list_tools/call_tool
# before raising a timeout error.
MCP_TIMEOUT_SECONDS=30.0

# --- Phase 5: Database MCP bootstrap (used ONLY by
#     services/db-mcp/db/setup_and_seed.py, never by the running
#     backend or db-mcp server — see that script's docstring) ---
# DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/adaptive_mcp
# DB_MCP_READER_PASSWORD=

# --- Phase 6: GitHub MCP (ACTIVE — read by backend/app/config.py) ---
GITHUB_MCP_URL=http://localhost:8003/mcp/
GITHUB_MCP_AUTH_TOKEN=dev-local-only-change-me
# GITHUB_TOKEN and ALLOWED_REPOSITORIES belong to services/github-mcp's
# OWN .env — never set here; the backend never holds a GitHub credential.

# --- Phase 3: RAG pipeline ---
# QDRANT_URL=http://localhost:6333
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Phase 10: Observability (ACTIVE) ---
# Unset means spans are still created (real parent/child relationships,
# real durations) but never exported anywhere — not a requirement to
# run this project. Set to a self-hosted OTLP collector (Jaeger, Tempo,
# an OTel Collector, etc.) to actually see traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=adaptive-mcp-enterprise-agent-backend
