SERVICE_NAME=github-mcp
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8003
LOG_LEVEL=INFO
LOG_FORMAT=json

# Must match GITHUB_MCP_AUTH_TOKEN in backend/.env
AUTH_TOKEN=dev-local-only-change-me

# Least-privilege, read-only PAT (classic PAT with 'repo' read scope,
# or fine-grained PAT with Contents: Read-only on the repos below).
# Used BY this server; never exposed to the LLM or the backend.
GITHUB_TOKEN=

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT_SECONDS=10.0

# Comma-separated allow-list. Empty = deny everything (fail closed).
# Example matching this project's running scenario:
ALLOWED_REPOSITORIES=myorg/payment-service

# --- Observability (Phase 10) ---
# Unset means spans are created but never exported anywhere.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
