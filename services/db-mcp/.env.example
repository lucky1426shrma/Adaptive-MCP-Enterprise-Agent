SERVICE_NAME=db-mcp
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO
LOG_FORMAT=json

# Must match DB_MCP_AUTH_TOKEN in backend/.env
AUTH_TOKEN=dev-local-only-change-me

# Read-only connection string for the db_mcp_reader role (see
# db/setup_and_seed.py). This server should NEVER be configured with an
# admin/superuser connection string.
DATABASE_URL=postgresql://db_mcp_reader:CHANGE_ME@localhost:5432/adaptive_mcp

QUERY_TIMEOUT_SECONDS=5.0
POOL_MIN_SIZE=1
POOL_MAX_SIZE=5
MAX_DATE_RANGE_DAYS=90

# --- Observability (Phase 10) ---
# Unset means spans are created but never exported anywhere.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
