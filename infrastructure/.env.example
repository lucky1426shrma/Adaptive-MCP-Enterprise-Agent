# Copy to infrastructure/.env before running docker compose commands
# from this directory. Compose automatically loads a .env file
# sitting next to docker-compose.yml — this is DIFFERENT from each
# service's own .env (which isn't used inside containers; environment
# variables come from docker-compose.yml's `environment:` blocks,
# populated FROM this file via ${VAR} substitution).

# --- Required: MCP server bearer tokens (backend <-> each MCP server) ---
RAG_MCP_AUTH_TOKEN=change-me-rag-token
DB_MCP_AUTH_TOKEN=change-me-db-token
GITHUB_MCP_AUTH_TOKEN=change-me-github-token

# --- Required: PostgreSQL ---
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin-password
DB_MCP_READER_PASSWORD=change-me-reader-password

# --- Required: OpenRouter (the ONLY LLM provider) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=              # must be an explicitly $0 OpenRouter model ID

# --- Optional: GitHub MCP ---
# Leave both unset to run github-mcp with an empty allow-list (fails
# closed — every search_recent_commits call is denied, not a security
# hole).
GITHUB_TOKEN=
ALLOWED_REPOSITORIES=

# --- Optional: RAG MCP ---
RAG_ENABLE_RERANKER=true

# --- Optional: backend-facing auth gate (Phase 9) ---
# Leave unset for an open backend (fine for local/demo use).
BACKEND_API_KEY=

# --- Optional: frontend CORS allowlist ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional: observability (Phase 10) ---
# Leave unset and every service still creates real spans, just doesn't
# export them anywhere. Point at a self-hosted OTLP collector to see
# traces (see docs/observability.md).
OTEL_EXPORTER_OTLP_ENDPOINT=
